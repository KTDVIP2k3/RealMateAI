# Dùng cho TEST LOCAL (Windows/VS Code) — KHÔNG dùng file này trên server,
# trên server các biến này đọc thẳng từ compose.yaml (environment:), lấy giá
# trị từ CHÍNH secrets DB_USERNAME/DB_PASSWORD Spring Boot đã khai báo sẵn
# trên GitHub Actions — KHÔNG cần secret riêng cho AI.

DB_HOST=localhost
DB_PORT=5433
DB_NAME=RealmateAi
DB_USER=<trung voi DB_USERNAME trong .env goc project Spring Boot>
DB_PASSWORD=<trung voi DB_PASSWORD trong .env goc project Spring Boot>
MODEL_DIR=./models
TOP_N=10
